# cocode 酷码工作室 · Cocode Studio VideoForge — server only
HOST=127.0.0.1
PORT=3088
PUBLIC_ORIGIN=http://localhost:3088
NODE_ENV=development
# Production: use HTTPS, COOKIE_SECURE=true; exact number of trusted proxy hops.
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# Persistent native DeepSeek agent. pipeline keeps the earlier five-stage compatibility path.
VIDEOFORGE_CREATION_MODE=harness
# Agent runs until delivery or user stop; no cumulative Token/call/task-time caps.
# Output window per model response; does not bound the size of saved multi-file projects.
VIDEOFORGE_THINKING=enabled
VIDEOFORGE_THINKING_EFFORT=low
VIDEOFORGE_MAX_OUTPUT_TOKENS=32768
VIDEOFORGE_MAX_REPAIRS=2
# Trusted local desktop execution. Public deployments must configure an isolated runner.
VIDEOFORGE_EXECUTION_MODE=local
VIDEOFORGE_EXECUTION_IMAGE=videoforge-creative:local
VIDEOFORGE_PYTHON=
BLENDER_PATH=
# Additional read-only skill folders, separated by semicolons; never auto-execute a skill installer.
VIDEOFORGE_EXTRA_SKILLS_ROOTS=
# Optional search gateway POST {query,kind}; otherwise uses Wikimedia Commons / Wikipedia.
VIDEOFORGE_SEARCH_API_URL=
VIDEOFORGE_SEARCH_API_KEY=
# Optional OpenAI-compatible vision Chat Completions service (base URL, without /chat/completions).
# Without it, requirement/code review runs and is labelled explicitly; no claimed visual review.
VIDEOFORGE_VISION_BASE_URL=
VIDEOFORGE_VISION_API_KEY=
VIDEOFORGE_VISION_MODEL=
# Optional image/video gateway. See docs/creation-pipeline.md for the POST/poll contract.
VIDEOFORGE_MEDIA_API_URL=
VIDEOFORGE_MEDIA_API_KEY=
# Optional narration gateway: POST {text,voice,format:"wav"}, returns WAV bytes.
# Alternatively prepare local Kokoro using the existing audio setup scripts.
VIDEOFORGE_TTS_API_URL=
VIDEOFORGE_TTS_API_KEY=
VIDEOFORGE_TTS_VOICE=zf_xiaobei
VIDEOFORGE_TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=Chinese_Graceful_Lady
MINIMAX_MODEL=speech-2.8-hd
MINIMAX_BASE_URL=https://api.minimax.io
# Optional source import; file keys must be explicitly permitted for the shared service token.
FIGMA_ACCESS_TOKEN=
FIGMA_ALLOWED_FILE_KEYS=
# Empty key: authentication/workspace still work; generation gives a clear error.
# Optional fallback, read only: ~/.dsh/settings.yaml and ~/.dsh/.credentials.yaml
TOKEN_BILLING_ENABLED=false
# Leave SSO values empty until the official OAuth/OIDC contract is provided.
OFFICIAL_SSO_ISSUER=
OFFICIAL_SSO_CLIENT_ID=
OFFICIAL_SSO_CLIENT_SECRET=
OFFICIAL_SSO_REDIRECT_URI=http://localhost:3088/api/auth/official/callback
OFFICIAL_SSO_SCOPES=openid profile email
KUMA_MAIL_API_URL=https://mail.kuma2.cn/api/v1/messages
KUMA_MAIL_API_KEY=
KUMA_MAIL_FROM=cocodekuma@gmail.com
KUMA_MAIL_TIMEOUT_MS=10000
RENDER_CONCURRENCY=1
MAX_QUEUED_JOBS=20
MAX_DAILY_GENERATIONS=20
INITIAL_WORKSPACE_CREDITS=20
# New accounts need this invitation code. Each registration IP shares this many successful videos.
INVITE_CODE=kuma
INVITE_FREE_VIDEOS_PER_IP=5
# Phase 2: read-only official membership/quota sync. Leave empty until the official API is ready.
OFFICIAL_QUOTA_API_URL=
OFFICIAL_QUOTA_API_KEY=
OFFICIAL_QUOTA_TIMEOUT_MS=10000
MAX_PROJECTS_PER_USER=100
RENDER_TIMEOUT_MS=600000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional existing Chrome Headless Shell executable, otherwise run:
# npx hyperframes browser ensure
PRODUCER_HEADLESS_SHELL_PATH=
DSH_DISABLE_PLUGIN_SCAN=true

# Official DeepSeek Flash reuses its endpoint/key for image understanding by default.
VIDEOFORGE_VISION_ENABLED=true
# Optional trusted host composition, mounted inside each conversation's scoped DSH context.
# Install matching rc.6 packages first. Never accept this setting from model/user files.
# VIDEOFORGE_DSH_PLUGINS=[{"name":"@deepseek-ai/dsh-mcp-client","config":{"transport":"streamable-http","serverName":"assets","url":"http://your-private-mcp/mcp"}}]

# 官网统一账号模式：启用后禁止本地账号登录，积分从官网同步。
OFFICIAL_ACCOUNTS_ONLY=false
# OFFICIAL_QUOTA_API_URL=https://www.kuma2.cn/api/quota.php
